# Optional: WalletConnect Cloud project ID to enable the WalletConnect connector.
# Get a free one at https://cloud.reown.com (formerly WalletConnect Cloud).
# If unset, only the injected connector (MetaMask / browser wallet) is available.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: override the Flare Mainnet RPC endpoint.
# Defaults to the public endpoint https://flare-api.flare.network/ext/C/rpc
VITE_FLARE_RPC_URL=
