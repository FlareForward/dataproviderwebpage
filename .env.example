# Optional: WalletConnect Cloud project ID.
# Get a free one at https://cloud.reown.com (formerly WalletConnect Cloud).
# Enables the WalletConnect option and the Ledger Live (WalletConnect) flow.
# If unset, MetaMask and D'CENT (browser extensions) and Ledger over USB still
# work; the WalletConnect option is shown as unavailable.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: override the Flare Mainnet RPC endpoint.
# Defaults to the public endpoint https://flare-api.flare.network/ext/C/rpc
VITE_FLARE_RPC_URL=
