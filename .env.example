# Optional: WalletConnect Cloud project ID.
# Get a free one at https://cloud.reown.com (formerly WalletConnect Cloud).
# Enables the WalletConnect option and the Ledger Live (WalletConnect) flow.
# If unset, MetaMask and D'CENT (browser extensions) and Ledger over USB still
# work; the WalletConnect option is shown as unavailable.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: override the Flare Mainnet RPC endpoint.
# Defaults to the public endpoint https://flare-api.flare.network/ext/C/rpc
VITE_FLARE_RPC_URL=

# Optional: override the provider performance-history feed used by the
# Analytics page (uptime / submissions / band-accuracy time-series).
# Defaults to the `performance` branch of the PUBLIC ftso-accuracy-data repo,
# published by the snapshot GitHub Action (.github/workflows/snapshot-performance.yml):
#   https://raw.githubusercontent.com/FlareForward/ftso-accuracy-data/performance/ftso-performance-history.json
# If that feed 404s (not published yet) the app falls back to the copy bundled
# from public/ftso-performance-history.json. For local preview, generate the
# file and serve it from public/:
#   OUT_PATH=public/ftso-performance-history.json node scripts/snapshot-performance.mjs
#   VITE_PERFORMANCE_URL=/ftso-performance-history.json
VITE_PERFORMANCE_URL=
