{
  // Static-assets-only Worker for the FlareForward FTSO data-provider portal.
  // Vite builds the SPA into ./dist; this uploads it as static assets with a
  // single-page-application 404 fallback so client routes (/providers,
  // /delegation) resolve to index.html instead of 404ing.
  "name": "ftso-flareforward",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
